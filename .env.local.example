# Anthropic — used server-side only for answer scoring
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Resend — used server-side only for email delivery
RESEND_API_KEY=your_resend_api_key_here

# Email address that receives all training results
# Must be a verified sender or recipient in your Resend account
SEND_TO_EMAIL=you@yourcompany.com

# Also update the `from` address in app/api/send-results/route.ts
# to a domain you have verified in Resend (e.g. training@yourcompany.com)
